Cell["\<\
{(ddp*(d - m)*(aa + m)*(cc + m)*y)/(aa*cc), (aa*bb*cc*ddp + aa*bb*cc*m + \
aa*cc*ddp*m + aa*cc*m^2 - ddp*y - aa*ddp*y - 
   cc*ddp*y - aa*cc*ddp*y + d*ddp*y + aa*d*ddp*y + cc*d*ddp*y - 3*ddp*m*y - \
2*aa*ddp*m*y - 2*cc*ddp*m*y + 2*d*ddp*m*y - 
   3*ddp*m^2*y)/(aa*cc), (aa*cc + aa*bb*cc + aa*cc*ddp + 2*aa*cc*m - 3*ddp*y \
- aa*ddp*y - cc*ddp*y + d*ddp*y - 3*ddp*m*y)/
