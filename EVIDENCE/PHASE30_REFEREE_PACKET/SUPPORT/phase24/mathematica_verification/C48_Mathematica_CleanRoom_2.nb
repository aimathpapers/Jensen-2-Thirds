Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "k", ",", "m", ",", "d", ",", "aa", ",", "bb", ",", "cc", ",", "ddp", ",",
      "lam", ",", "coef"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Intended", " ", 
     RowBox[{"domain", ":", "d"}]}], ",", "m", ",", 
    RowBox[{"k", " ", "are", " ", "integers"}], ",", 
    RowBox[{"0", "<=", "m", "<=", "d"}], ",", 
    RowBox[{
     RowBox[{"0", "<=", "k", "<=", 
      RowBox[{"d", "-", "m"}]}], ";", "\[IndentingNewLine]", "aa"}], ",", 
    "bb", ",", "cc", ",", 
    RowBox[{"ddp", " ", "are", " ", 
     RowBox[{"positive", "."}]}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"coef", "[", "k_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"m", "-", "d"}], ",", "k"}], "]"}], "*", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"aa", "+", "m"}], ",", "k"}], "]"}], "*", 
     RowBox[{"Pochhammer", "[", 
      RowBox[{
       RowBox[{"cc", "+", "m"}], ",", "k"}], "]"}], "*", 
     RowBox[{
      RowBox[{"lam", "^", "k"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          RowBox[{"bb", "+", "m"}], ",", "k"}], "]"}], "*", 
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          RowBox[{"ddp", "+", "m"}], ",", "k"}], "]"}], "*", 
        RowBox[{"k", "!"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stepRules", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"HoldPattern", "[", 
        RowBox[{"Pochhammer", "[", 
         RowBox[{"x_", ",", 
          RowBox[{"1", "+", "k"}]}], "]"}], "]"}], ":>", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "+", "k"}], ")"}], " ", 
        RowBox[{"Pochhammer", "[", 
         RowBox[{"x", ",", "k"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"HoldPattern", "[", 
        RowBox[{"Factorial", "[", 
         RowBox[{"1", "+", "k"}], "]"}], "]"}], ":>", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "k"}], ")"}], " ", 
        RowBox[{"Factorial", "[", "k", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"HoldPattern", "[", 
        RowBox[{"lam", "^", 
         RowBox[{"(", 
          RowBox[{"1", "+", "k"}], ")"}]}], "]"}], ":>", 
       RowBox[{"lam", " ", 
        RowBox[{"lam", "^", "k"}]}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ratioRaw", "=", 
    RowBox[{
     RowBox[{"coef", "[", 
      RowBox[{"k", "+", "1"}], "]"}], "/", 
     RowBox[{"coef", "[", "k", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ratioFromSteps", "=", 
    RowBox[{"Factor", "@", 
     RowBox[{"Cancel", "[", 
      RowBox[{"ratioRaw", "/.", " ", "stepRules"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coefficientRatio", "=", 
    RowBox[{"Factor", "[", 
     RowBox[{"ratioFromSteps", "/.", " ", 
      RowBox[{"lam", "->", 
       RowBox[{"ddp", "/", 
        RowBox[{"(", 
         RowBox[{"aa", " ", "cc"}], ")"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"coefficientRatio", "//", "InputForm"}]}], "Input",
