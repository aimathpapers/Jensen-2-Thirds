Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"alpha", ",", "t", ",", "w", ",", "delta"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{"alpha", ",", "t", ",", "w", ",", "delta"}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "alpha"}], "+", 
       RowBox[{"w", "/", 
        RowBox[{"t", "^", "2"}]}], "+", "delta", "-", "2"}], ",", 
      RowBox[{
       RowBox[{"w", "/", 
        RowBox[{"t", "^", "3"}]}], "+", "delta", "-", "1"}], ",", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"w", "/", 
         RowBox[{"t", "^", "4"}]}]}], "+", 
       RowBox[{"3", " ", "delta"}], "-", "2"}], ",", 
      RowBox[{
       RowBox[{"4", " ", 
        RowBox[{"w", "/", 
         RowBox[{"t", "^", "5"}]}]}], "+", 
       RowBox[{"4", " ", "delta"}], "-", "2"}]}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"positiveSolution", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Reduce", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"And", "@@", 
         RowBox[{"Thread", "[", 
          RowBox[{"f", "==", "0"}], "]"}]}], "&&", 
        RowBox[{"And", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#", ">", "0"}], "&"}], "/@", "vars"}], ")"}]}]}], ",", 
       "vars", ",", "Reals"}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"jac", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"vars", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"point", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{"vars", "->", 
     RowBox[{"{", 
      RowBox[{"3", ",", "2", ",", 
       RowBox[{"16", "/", "3"}], ",", 
       RowBox[{"1", "/", "3"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jacAtPoint", "=", 
   RowBox[{"jac", "/.", " ", "point"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"jacInverse", "=", 
    RowBox[{"Inverse", "[", "jacAtPoint", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m3Results", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<PositiveSolution\>\"", "->", "positiveSolution"}], ",", 
      RowBox[{"\"\<Jacobian\>\"", "->", "jacAtPoint"}], ",", 
      RowBox[{"\"\<Determinant\>\"", "->", 
       RowBox[{"Det", "[", "jacAtPoint", "]"}]}], ",", 
      RowBox[{"\"\<Inverse\>\"", "->", "jacInverse"}], ",", 
      RowBox[{"\"\<InfinityNorm\>\"", "->", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Abs", "[", "#", "]"}], "]"}], "&"}], "/@", "jacInverse"}],
         "]"}]}]}], "|>"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
