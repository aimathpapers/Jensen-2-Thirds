 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hyperPoly", "[", 
     RowBox[{"dv_", ",", "av_", ",", "bv_", ",", "cv_", ",", "ev_"}], "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Pochhammer", "[", 
        RowBox[{
         RowBox[{"-", "dv"}], ",", "j"}], "]"}], "*", 
       RowBox[{"Pochhammer", "[", 
        RowBox[{"av", ",", "j"}], "]"}], "*", 
       RowBox[{"Pochhammer", "[", 
        RowBox[{"cv", ",", "j"}], "]"}], "*", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ev", " ", 
           RowBox[{"y", "/", 
            RowBox[{"(", 
             RowBox[{"av", " ", "cv"}], ")"}]}]}], ")"}], "^", "j"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Pochhammer", "[", 
           RowBox[{"bv", ",", "j"}], "]"}], "*", 
          RowBox[{"Pochhammer", "[", 
           RowBox[{"ev", ",", "j"}], "]"}], "*", 
          RowBox[{"j", "!"}]}], ")"}]}]}], ",", 
      RowBox[{"{", 
