Cell[CellGroupData[{

Cell["\<\
0

ClearAll[
  y, g, theta, shift, lhs, rhs, ode,
  lambda0, odeDerivativeCoefficients
];

lambda0 = ddp/(aa cc);

theta[expr_] := Expand[y D[expr, y]];

shift[expr_, c0_] :=
  Expand[theta[expr] + c0 expr];

lhs =
  theta[
    shift[
      shift[g[y], ddp + m - 1],
      bb + m - 1
    ]
  ];

rhs =
  lambda0 y *
    shift[
      shift[
        shift[g[y], cc + m],
        aa + m
      ],
      m - d
    ];

ode = Expand[lhs - rhs];

odeDerivativeCoefficients = {
  Factor[Coefficient[ode, g[y]]],
  Factor[Coefficient[ode, g'[y]]],
  Factor[Coefficient[ode, g''[y]]],
  Factor[Coefficient[ode, g'''[y]]]
};

odeDerivativeCoefficients // InputForm\
\>", "Input",
 CellChangeTimes->{{3.996001749442708*^9, 3.9960017518746758`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"12411613-1c36-45ed-8944-4fc29b433d3e"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.996001753099021*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"71d5bcac-16c2-4769-bd9d-7f286a3e31b7"],

Cell["\<\
{(ddp*(d - m)*(aa + m)*(cc + m)*y)/(aa*cc), 
 (y*(aa*bb*cc*ddp + aa*bb*cc*m + aa*cc*ddp*m + aa*cc*m^2 - ddp*y - aa*ddp*y - \
cc*ddp*y - aa*cc*ddp*y + d*ddp*y + 
    aa*d*ddp*y + cc*d*ddp*y - 3*ddp*m*y - 2*aa*ddp*m*y - 2*cc*ddp*m*y + \
2*d*ddp*m*y - 3*ddp*m^2*y))/(aa*cc), 
 -((y^2*(-(aa*cc) - aa*bb*cc - aa*cc*ddp - 2*aa*cc*m + 3*ddp*y + aa*ddp*y + \
cc*ddp*y - d*ddp*y + 3*ddp*m*y))/(aa*cc)), 
 -((y^3*(-(aa*cc) + ddp*y))/(aa*cc))}\
\>", "Output",
 CellChangeTimes->{3.9960017531017437`*^9},
 CellLabel->
  "Out[44]//InputForm=",ExpressionUUID->"c9942bad-b77b-44ac-bd79-\
4e9db8986a8e"]
}, Open  ]],

