Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"tau", ",", "recurrenceRaw", ",", "derivedP"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"recurrenceRaw", "=", 
    RowBox[{"ode", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"g", "[", "y", "]"}], ":>", 
        RowBox[{
         RowBox[{"tau", "[", "m", "]"}], "/", 
         RowBox[{"y", "^", "m"}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "j_", "]"}], "[", "g", "]"}], "[", "y", 
         "]"}], ":>", 
        RowBox[{
         RowBox[{"tau", "[", 
          RowBox[{"m", "+", "j"}], "]"}], "/", 
         RowBox[{"y", "^", 
          RowBox[{"(", 
           RowBox[{"m", "+", "j"}], ")"}]}]}]}]}], "}"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"recurrenceRaw", "=", 
    RowBox[{"Expand", "@", 
     RowBox[{"Cancel", "@", 
      RowBox[{"Together", "[", 
       RowBox[{
        RowBox[{"y", "^", "m"}], " ", "recurrenceRaw"}], "]"}]}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"derivedP", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Factor", "[", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"recurrenceRaw", ",", 
         RowBox[{"tau", "[", "m", "]"}]}], "]"}], "]"}], ",", 
      RowBox[{"Factor", "[", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"recurrenceRaw", ",", 
         RowBox[{"tau", "[", 
          RowBox[{"m", "+", "1"}], "]"}]}], "]"}], "]"}], ",", 
      RowBox[{"Factor", "[", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"recurrenceRaw", ",", 
         RowBox[{"tau", "[", 
          RowBox[{"m", "+", "2"}], "]"}]}], "]"}], "]"}], ",", 
      RowBox[{"Factor", "[", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"recurrenceRaw", ",", 
         RowBox[{"tau", "[", 
          RowBox[{"m", "+", "3"}], "]"}]}], "]"}], "]"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"derivedP", "//", "InputForm"}]}], "Input",
 CellChangeTimes->{{3.9960017990512*^9, 3.996001799051338*^9}},
