       ";", "\[IndentingNewLine]", 
       RowBox[{"gm", "=", 
        RowBox[{"D", "[", 
         RowBox[{"poly", ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "mm"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"lambdaValue", "=", 
        RowBox[{"ev", "/", 
         RowBox[{"(", 
          RowBox[{"av", " ", "cv"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"thetaValue", "[", "expr_", "]"}], ":=", 
        RowBox[{"Expand", "[", 
