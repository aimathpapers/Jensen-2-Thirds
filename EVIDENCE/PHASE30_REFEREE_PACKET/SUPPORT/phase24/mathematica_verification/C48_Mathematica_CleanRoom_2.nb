    "a0", ",", "b0", ",", "c0", ",", "epsilon0", ",", "beta0", ",", "gamma0", 
     ",", "expectedP", ",", "recurrenceComparison"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a0", "=", 
