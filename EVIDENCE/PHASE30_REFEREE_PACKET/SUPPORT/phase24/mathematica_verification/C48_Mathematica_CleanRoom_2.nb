       RowBox[{"j", "/", "aa"}]}], ")"}], " ", "y"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"epsilon0", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"cc", "-", "ddp"}], ")"}], "/", "cc"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"beta0", "[", "j_", "]"}], ":=", 
