Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"crossMultipliedCheck", "=", 
    RowBox[{"Factor", "@", 
     RowBox[{"Cancel", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "+", "1"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"k", "+", "bb", "+", "m"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"k", "+", "ddp", "+", "m"}], ")"}], "*", 
          RowBox[{"coef", "[", 
           RowBox[{"k", "+", "1"}], "]"}]}], "-", 
         RowBox[{"lam", "*", 
          RowBox[{"(", 
           RowBox[{"k", "+", "m", "-", "d"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"k", "+", "aa", "+", "m"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"k", "+", "cc", "+", "m"}], ")"}], "*", 
          RowBox[{"coef", "[", "k", "]"}]}]}], ")"}], "/.", " ", 
       "stepRules"}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"crossMultipliedCheck", "//", "InputForm"}]}], "Input",
 CellChangeTimes->{{3.996001523239357*^9, 3.996001523239387*^9}},
